<Window x:Class="WPF_LoginForm.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        xmlns:local="clr-namespace:WPF_LoginForm.Views"
        xmlns:viewModel="clr-namespace:WPF_LoginForm.ViewModels"
        
        mc:Ignorable="d"
        Title="MainWindowView" Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        WindowState="Maximized">
    

    <Window.DataContext>
        <viewModel:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>

        <DataTemplate DataType="{x:Type viewModel:AnaMenuViewModel}">
            <local:AnaMenuView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:HesapKesimViewModel}">
            <local:hesapkesimView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:KantarExcelViewModel}">
            <local:KantarExcelView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:SiparisViewModel}">
            <local:SiparisView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:hesapkesimDetayViewModel}">
            <local:hesapkesimDetayView/>
        </DataTemplate>

    </Window.Resources>

    <Border CornerRadius="10"                    
            BorderThickness="1">

        <Border.BorderBrush>

        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource winBorderColor4}" Offset="0"/>
            <GradientStop Color="{StaticResource winBorderColor5}" Offset="0.75"/>
            <GradientStop Color="{StaticResource winBorderColor6}" Offset="1"/>
        </LinearGradientBrush>
    </Border.BorderBrush>

        <Grid>

            <Grid.ColumnDefinitions>
                <!-- Navigation Menu -->
                <ColumnDefinition Width="250"/>
                <!--Content Section-->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            
            <!--Navigation Menu-->

            <Border CornerRadius="10,0,0,10"
                    Grid.Column="0">

                <Border.Background >

                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.75">
                        <GradientStop Color="{StaticResource secondaryBackColor1}" Offset="0" />
                        <GradientStop Color="{StaticResource secondaryBackColor2}" Offset="1" />

                    </LinearGradientBrush>
 
                </Border.Background>



                <StackPanel>
                    <!--Logo-->

                    <StackPanel Orientation="Horizontal"
                                Height="35"
                                Margin="15,25,0,40">
                        <Image Source="/Images/logo.png" Height="30"/>
                        <TextBlock Text="ENFA SİSTEM " 
                                   Foreground="{StaticResource titleColor1}"
                                   FontSize="20"
                                   FontFamily="Montserrat"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>


                    </StackPanel>
                    
                    <!--Menu Buttons -->

                    <RadioButton Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color11}"
                                 Command="{Binding ShowHomeViewCommand}"
                                 >
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Home" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Ana Menü" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                    

                    <RadioButton Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color13}"
                                 Command="{Binding ShowHesapKesimViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="HandshakeAngle" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Hesap Kesim" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color14}"
                                 Command="{Binding ShowKantarExcelViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="FileExcel" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Kantar Excel" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color15}"
                                 Command="{Binding ShowFiyatGirisViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="FileInvoiceDollar" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Fiyat Girişi" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color16}"
                                 Command="{Binding ShowAyarlarViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Sliders" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Ayarlar" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                </StackPanel>
                
            </Border>
            
            
            <!--Content Section-->
            <Border CornerRadius="0,10,10,0"
                    Grid.Column="1">

                <Border.Background >

                    <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                        <GradientStop Color="{StaticResource primaryBackColor1}" Offset="0" />
                        <GradientStop Color="{StaticResource primaryBackColor2}" Offset="1" />

                    </LinearGradientBrush>

                </Border.Background>
                <!--Control Bar-->
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height=" 25"/>
                        <!--Headet Caption-->
                        <RowDefinition Height="35"/>
                        <!--Content Section Child Views-->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="pnlControlBar" 
                                Grid.Row="0"
                                Orientation="Horizontal"
                                FlowDirection="RightToLeft"
                                Background="Transparent"
                                Margin="0,0,0,5"
                                MouseLeftButtonDown="pnlControlBar_MouseLeftButtonDown"
                                MouseEnter="pnlControlBar_MouseEnter">
                        
                        <Button x:Name="btnClose"
                                Style="{StaticResource controlButton}"
                                Tag="{StaticResource color6}"
                                Click="btnClose_Click">
                            <fa:IconImage Icon="Xmark" Style="{StaticResource controlButtonIcon}" />

                        </Button>
                        
                        <Button x:Name="btnMaximize"
                                Style="{StaticResource controlButton}"
                                Tag="{StaticResource color6}"
                                Click="btnMaximize_Click">
                            <fa:IconImage Icon="Square" Style="{StaticResource controlButtonIcon}" />

                        </Button>

                        <Button x:Name="btnMinimize"
                                Style="{StaticResource controlButton}"
                                Tag="{StaticResource color6}"
                                Click="btnMinimize_Click">
                            <fa:IconImage Icon="WindowMinimize" Style="{StaticResource controlButtonIcon}" />

                        </Button>

                    </StackPanel>
                    
                    <!--Header Section-->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        
                        
                        <!--Caption-->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            
                            <fa:IconImage Icon="{Binding Icon}"
                                          Width="20"
                                          Height="20"
                                          Foreground="{StaticResource titleColor2}"
                                          Margin="35,0,10,0"/>

                            <TextBlock Text="{Binding Caption}"
                                       Foreground="{StaticResource titleColor2}"
                                       FontSize="16"
                                       FontFamily="Montserrat"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                         </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    FlowDirection="RightToLeft"
                                    Margin="0,0,10,0">

                            <Button Style="{StaticResource iconButton}"
                                    Tag="{StaticResource color1}">
                                <fa:IconImage Icon="AngleDown"  
                                              Width="12" Height="12"
                                              Style="{StaticResource iconButtonIcon}"/>
                            </Button>

                            <TextBlock Text="{Binding CurrentUserAccount.DisplayName}"
                                       Foreground="{StaticResource titleColor3}"
                                       FontFamily="Montserrat"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>

                            <Ellipse Height="35" Width="35"
                                     Stroke="{StaticResource color2}"
                                     StrokeThickness="2"
                                     Margin="10,0,10,0">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="/Images/UserImageEnes.png"/>
                                </Ellipse.Fill>
                            </Ellipse>


                            <Button Style="{StaticResource iconButton}"
                                    Tag="{StaticResource color3}">
                                <fa:IconImage Icon="Clock" Style="{StaticResource iconButtonIcon}"/>
                            </Button>

                            <Button Style="{StaticResource iconButton}"
                                    Tag="{StaticResource color4}">
                                <fa:IconImage Icon="Envelope" Style="{StaticResource iconButtonIcon}"/>
                            </Button>

                            <Button Style="{StaticResource iconButton}"
                                    Tag="{StaticResource color5}">
                                <fa:IconImage Icon="Bell" Style="{StaticResource iconButtonIcon}"/>
                            </Button>


                        </StackPanel>
                            
                            
                            
                            





                    </Grid>

                    <!--Content Section Child Views-->

                    <ContentControl Content="{Binding CurrentChildView }"
                                    Grid.Row="2"
                                    Margin="25"/>
                    <!--<Frame x:Name="MainFrame" Content="{Binding CurrentPage, Converter={local:ApplicationPageValueConverter}}" Grid.Row="2" NavigationUIVisibility="Hidden" />-->



                </Grid>
            </Border>





        </Grid>






    </Border>


    
    

</Window>
