<UserControl x:Class="WPF_LoginForm.Views.AnaMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPF_LoginForm.Views"
              xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             mc:Ignorable="d" 
d:DesignHeight="450" d:DesignWidth="800">
    <!--Navigation Menu-->
    <Border CornerRadius="10,0,0,10"
        Grid.Column="0">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.75">
                <GradientStop Color="{StaticResource secondaryBackColor1}" Offset="0" />
                <GradientStop Color="{StaticResource secondaryBackColor2}" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <StackPanel>
          

            <!--Menu Buttons Grid-->
            <Grid Margin="20" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Hesap Kesim -->
                <Button Grid.Row="1" Grid.Column="1"
            Style="{StaticResource menusqButton}"
            Command="{Binding ShowHesapKesimViewCommand}"
            Margin="5">
                    <Viewbox>
                        <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="200">
                            <fa:IconImage Icon="HandshakeAngle" 
                            Style="{StaticResource menuButtonIcon}"
                            Width="40" Height="40"/>
                            <TextBlock Text="Hesap Kesim" 
                         Style="{StaticResource menuButtonText}"
                         Margin="0,10,0,0"/>
                        </StackPanel>
                    </Viewbox>
                </Button>

                <!-- Kantar Excel -->
                <Button Grid.Row="1" Grid.Column="2"
                    Style="{StaticResource menusqButton}"
                    Command="{Binding ShowKantarExcelViewCommand}"
                    Margin="5">
                    <Viewbox>
                        <StackPanel Orientation="Vertical"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    Width="200">
                            <fa:IconImage Icon="FileExcel" 
        Style="{StaticResource menuButtonIcon}"
        Width="40" Height="40"/>
                            <TextBlock Text="Kantar Excel" 
     Style="{StaticResource menuButtonText}"
     Margin="0,10,0,0"/>
                        </StackPanel>
                    </Viewbox>
                </Button>

                <!-- Fiyat Girişi -->
                <Button Grid.Row="2" Grid.Column="1"
                    Style="{StaticResource menusqButton}"
                    Command="{Binding ShowFiyatGirisViewCommand}"
                    Margin="5">
                    <Viewbox>
                        <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="200">
                            <fa:IconImage Icon="FileInvoiceDollar" 
                            Style="{StaticResource menuButtonIcon}"
                            Width="40" Height="40"/>
                            <TextBlock Text="Fiyat Girişi" 
                         Style="{StaticResource menuButtonText}"
                         Margin="0,10,0,0"/>
                        </StackPanel>
                    </Viewbox>
                 
                </Button>

                <!-- Ayarlar -->
                <Button Grid.Row="2" Grid.Column="2"
                    Style="{StaticResource menusqButton}"
                    Command="{Binding ShowAyarlarViewCommand}"
                    Margin="5">
                    <Viewbox>
                        <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="200">
                            <fa:IconImage Icon="Sliders" 
                            Style="{StaticResource menuButtonIcon}"
                            Width="40" Height="40"/>
                            <TextBlock Text="Ayarlar" 
                         Style="{StaticResource menuButtonText}"
                         Margin="0,10,0,0"/>
                        </StackPanel>
                    </Viewbox>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
