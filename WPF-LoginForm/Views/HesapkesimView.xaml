<UserControl x:Class="WPF_LoginForm.Views.hesapkesimView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
          
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
              xmlns:viewModel="clr-namespace:WPF_LoginForm.ViewModels" xmlns:customcontrols="clr-namespace:WPF_LoginForm.CustomControls" d:DataContext="{d:DesignInstance Type=viewModel:HesapKesimViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MaxHeight="60"/>
            <RowDefinition Height="*" MaxHeight="50"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="*" MaxHeight="50"/>

        </Grid.RowDefinitions>


        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel  Grid.Column="0"
                         Orientation="Horizontal"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Stretch">



                <Button Style="{StaticResource controlButton}"
                                    Tag="{StaticResource color1}" 
                        Command="{Binding SearchCommand}">
                    <fa:IconImage Icon="Search"
                                  Style="{StaticResource iconButtonIcon}"
                                  Width="23"
                                  Height="23"
                                  Margin="1,1,1,1"
                                  />
                </Button>



                <TextBox x:Name="txtSearch"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource nsTextBox}"  >

                </TextBox>


            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">

                <Button Style="{StaticResource controlButton}"
                        Tag="{StaticResource color3}"
                        Command="{Binding AddCommand}">

                    <fa:IconImage Icon="Add"
                        Style="{StaticResource iconButtonIcon}"
                                  Width="30"
                                  Margin="1"/>
                </Button>

                <Button Style="{StaticResource controlButton}"
                        Tag="{StaticResource color1}"
                        Command="{Binding EditCommand}">

                    <fa:IconImage Icon="ExchangeAlt"
                        Style="{StaticResource iconButtonIcon}"
                                  Width="30"
                                  Margin="1"/>
                </Button>

                <Button Style="{StaticResource controlButton}"
                        Tag="{StaticResource color1}" Command="{Binding DeleteCommand}">

                    <fa:IconImage Icon="TrashCan"
                        Style="{StaticResource iconButtonIcon}"
                                  Width="30"
                                  Margin="1"/>
                </Button>





            </StackPanel>




        </Grid>

        <Grid Grid.Row="1">
            <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource controlButton}"
                    Tag="{StaticResource color1}" 
                    Command="{Binding SearchCommand}">
                    <fa:IconImage Icon="Calculator"
                    Style="{StaticResource iconButtonIcon}"
                    Width="23"
                    Height="23"
                    Margin="1,1,1,1"
                  />
                </Button>




            </StackPanel>



        </Grid>

        <Grid Grid.Row="2" >

            <DataGrid RowStyle="{StaticResource DataGridRowStyle1}" 
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle1}" 
                      
                  
                      x:Name="hesapkesimDataGrid"
                      IsReadOnly="True"
                      AutoGenerateColumns="True"
                      ItemsSource="{Binding hesapkesimTablo, UpdateSourceTrigger=PropertyChanged}"
                      SelectedItem="{Binding SelectedItem,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      AlternatingRowBackground="{StaticResource tabloColorRowSecondary}"
                      RowBackground="{StaticResource tabloColorRowPrimary}" Background="{x:Null}"
                      
                      
                      >
                
            </DataGrid>

        </Grid>




    </Grid>
</UserControl>
