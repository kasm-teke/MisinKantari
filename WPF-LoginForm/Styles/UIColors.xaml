<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Diğer mevcut renk tanımlarınızın yanına ekleyin -->

    <!-- Gölge rengi (Yarı saydam siyah) -->
    <Color x:Key="shadowColor">#40000000</Color>

    <!-- Buton kenarlık rengi (Açık mavi ton) -->
    <SolidColorBrush x:Key="buttonBorderColor" Color="#3B82F6"/>

    <!-- Hover efekti rengi (Açık mavi arkaplan) -->
    <SolidColorBrush x:Key="buttonHoverColor" Color="#E0F2FE"/>

    <!-- Basılı efekt rengi (Orta ton mavi) -->
    <SolidColorBrush x:Key="buttonPressedColor" Color="#BFDBFE"/>

    <!-- İkon ve metin renkleri -->
    <SolidColorBrush x:Key="iconColor1" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="textColor1" Color="#1E3A8A"/>



    <!--Background Colors-->
    <Color x:Key="primaryBackColor1">#3C4561</Color>
    <Color x:Key="primaryBackColor2">#444E6E</Color>
