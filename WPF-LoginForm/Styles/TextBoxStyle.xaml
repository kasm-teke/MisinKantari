<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TextBox}"
           x:Key="nsTextBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border CornerRadius="0"
                            BorderBrush="{StaticResource color3}"
                            Background="Transparent"
                            BorderThickness="0,0,0,2"
                            Width="200"
                            Height="35">
                        
                        
                        
                        <Grid>
                            <Rectangle StrokeThickness="1"/>
                            <TextBox Margin="1"
                                     Text="{TemplateBinding Text}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     HorizontalAlignment="Left"
                                     Padding="10,0,0,0"
                                     Foreground="#CFCFCF"
                                     FontSize="20"
                                     x:Name="SearchBox"/>
                            <TextBlock IsHitTestVisible="false"
                                       Text="Arama..."
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="15,0,0,0"
                                       FontSize="20"
                                       Foreground="DarkGray"
                                      
                                       Grid.Column="1">
                                <TextBlock.Style >
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Style.Triggers  >
                                            <DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>

                                        </Style.Triggers>
                                        <Setter Property="Visibility" Value="Hidden"/>
                                    </Style>

                                </TextBlock.Style>
                            </TextBlock>


                            
                                                    

                        </Grid>
                            
                      
                    </Border>                       
                             
                             
                            
                        
                         
                    
                </ControlTemplate> 
                
                
            </Setter.Value>
            
        </Setter>
        
        
    </Style>

    <Style TargetType="{x:Type TextBlock}" x:Key="nsTextblock">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Foreground" Value="{StaticResource colorForeGround3}"/>
        <Setter Property="Text" Value="{Binding Text}"/>
        <Setter Property="Margin" Value="7"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontFamily" Value="Monteserrat"/>

    </Style>


    <Style TargetType="{x:Type TextBox}"
           x:Key="nsTextBox2">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border CornerRadius="0"
                            BorderBrush="{StaticResource colorBackGround3}"
                            Background="Transparent" 
                            BorderThickness="1,1,1,01"
                            Width="auto"
                            MinWidth="200"
                            Height="30">



                        <Grid>
                            <Rectangle StrokeThickness="1"/>
                            <TextBox Margin="1"
                                     Text="{TemplateBinding Text}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     HorizontalAlignment="Left"
                                     Padding="10,0,0,0"
                                     Foreground="#CFCFCF"
                                     FontSize="15"
                                     />
                            
                        </Grid>


                    </Border>






                </ControlTemplate>


            </Setter.Value>

        </Setter>


    </Style>




</ResourceDictionary>